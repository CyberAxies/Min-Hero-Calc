{
  "name": "min-hero-calc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run icons",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:import": "node scripts/import-game-data.mjs",
    "data:check": "vitest run tests/data.test.ts",
    "assets:import": "node scripts/import-assets.mjs",
    "assets:check": "node scripts/check-assets.mjs && vitest run tests/assets.test.ts",
    "icons": "node scripts/make-icons.mjs",
    "icons:mobile": "node scripts/make-mobile-icons.mjs",
    "android:icons": "npm run icons:mobile && capacitor-assets generate --android",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs",
    "desktop:install": "npm --prefix desktop install",
    "desktop:app": "npm --prefix desktop run dist",
    "desktop:smoke": "npm --prefix desktop run smoke",
    "desktop:setup": "npm --prefix desktop run electron:setup",
    "verify": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
